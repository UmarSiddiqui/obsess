+// Top-down ground for the stall: red-brick footpath in front of the counter, a red and white
+// kerb, a dusty street where customers queue and walk in, an open drain, and marigold petals.
+// Canvas row 0 is the far edge (z = GROUND.z0), so rows map straight onto the ground plane.
+function streetTexture() {
+  const ppu = 32;
+  const W = (GROUND.x1 - GROUND.x0) * ppu;
+  const H = (GROUND.z1 - GROUND.z0) * ppu;
+  const X = (x) => (x - GROUND.x0) * ppu;
+  const Z = (z) => (z - GROUND.z0) * ppu;
+  return canvasTex(W, H, (g) => {
+    g.fillStyle = '#7f6c5a';
+    g.fillRect(0, 0, W, H);
+    for (let x = GROUND.x0; x < GROUND.x1; x++) {
+      for (let z = GROUND.z0; z < GROUND.z1; z++) {
+        const k = 0.8 + Math.random() * 0.34;
+        g.fillStyle = `rgb(${(150 * k) | 0},${(130 * k) | 0},${(108 * k) | 0})`;
+        g.fillRect(X(x) + 2, Z(z) + 2, ppu - 4, ppu - 4);
+      }
+    }
+    // Footpath of brick, z 0.9 to 2.45.
+    for (let z = 0.9, row = 0; z < 2.45; z += 0.25, row++) {
+      for (let x = GROUND.x0 - 0.5; x < GROUND.x1; x += 0.5) {
+        const k = 0.8 + Math.random() * 0.3;
+        g.fillStyle = `rgb(${(164 * k) | 0},${(78 * k) | 0},${(48 * k) | 0})`;
+        g.fillRect(X(x + (row % 2 ? 0.25 : 0)) + 1, Z(z) + 1, ppu / 2 - 2, ppu / 4 - 2);
+      }
+    }
+    // Red and white kerb, z 2.45 to 2.6.
+    for (let x = GROUND.x0; x < GROUND.x1; x += 0.3) {
+      g.fillStyle = (Math.floor((x - GROUND.x0) / 0.3) % 2) ? '#f4ead6' : '#c8322a';
+      g.fillRect(X(x), Z(2.45), (0.3 * ppu), 0.15 * ppu);
+    }
+    // Dusty street, z 2.6 to 8.6, with worn wheel tracks and speckles.
+    g.fillStyle = '#6d5d4e';
+    g.fillRect(0, Z(2.6), W, Z(8.6) - Z(2.6));
+    for (let i = 0; i < 1400; i++) {
+      const light = Math.random() < 0.5;
+      g.fillStyle = light ? 'rgba(214,190,150,0.35)' : 'rgba(40,28,20,0.3)';
+      g.fillRect(Math.random() * W, Z(2.6) + Math.random() * (Z(8.6) - Z(2.6)), 2, 2);
+    }
+    g.fillStyle = 'rgba(40,28,20,0.22)';
+    for (const z of [4.1, 6.3]) g.fillRect(0, Z(z), W, 0.5 * ppu);
+    // Open drain with grate bars, z 8.6 to 9.1, then a kerb.
+    g.fillStyle = '#2e2620';
+    g.fillRect(0, Z(8.6), W, 0.5 * ppu);
+    g.fillStyle = '#4a3f36';
+    for (let x = GROUND.x0; x < GROUND.x1; x += 0.35) g.fillRect(X(x), Z(8.6), 0.1 * ppu, 0.5 * ppu);
+    g.fillStyle = '#c8322a';
+    g.fillRect(0, Z(9.1), W, 0.12 * ppu);
+    // Marigold petals on the footpath and street.
+    const petals = ['#f08a1c', '#ffb020', '#e86a14', '#ffd34a'];

+      const z = 0.9 + Math.random() * 7.6;
+      g.fillStyle = petals[i % petals.length];
+      g.beginPath();
+      g.arc(X(x), Z(z), 2 + Math.random() * 1.5, 0, TAU);
+      g.fill();
+    }
+  });

+// The largest rectangle of the window that no UI card covers. Each card cuts away the
+// side that leaves the most room, so the plan is always framed clear of the HUD, the
+// top bar and the panel (wherever they sit for this screen shape).
+function freeRect(w, h, blockers) {
+  let r = { x: 0, y: 0, w, h };
+  for (const b of blockers) {
+    if (b.w <= 0 || b.h <= 0) continue;
+    const overlaps = b.x < r.x + r.w && b.x + b.w > r.x && b.y < r.y + r.h && b.y + b.h > r.y;
+    if (!overlaps) continue;
+    const right = r.x + r.w, bottom = r.y + r.h;
+    const options = [
+      { x: r.x, y: r.y, w: b.x - r.x, h: r.h },
+      { x: b.x + b.w, y: r.y, w: right - (b.x + b.w), h: r.h },
+      { x: r.x, y: r.y, w: r.w, h: b.y - r.y },
+      { x: r.x, y: b.y + b.h, w: r.w, h: bottom - (b.y + b.h) },
+    ];
+    const area = (o) => Math.max(0, o.w) * Math.max(0, o.h);
+    r = options.reduce((best, o) => (area(o) > area(best) ? o : best));
+  }
+  return r;
+}
+

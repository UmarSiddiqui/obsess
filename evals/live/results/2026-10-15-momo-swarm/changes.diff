+// Feature checks for festivals and customer kinds, run against the real sim.
+// Run with: node tests/features.mjs
+import assert from 'node:assert/strict';
+import * as sim from '../js/sim.js';
+import { CUSTOMER_KINDS, FESTIVALS, FESTIVAL_EVERY_SECONDS, FESTIVAL_SECONDS } from '../js/data.js';
+
+const DT = 0.1;
+const ticks = (secs) => Math.round(secs / DT);
+
+// Deterministic randomness so spawn counts are repeatable.
+let seed = 7;
+Math.random = () => {
+  seed = (seed * 16807) % 2147483647;
+  return seed / 2147483647;
+};
+
+let passed = 0;
+function check(name, fn) {
+  fn();
+  passed++;
+  console.log(`ok  ${name}`);
+}
+
+// Advance a game and keep the queue empty so every spawn counts as an arrival.
+function spawnsOver(s, secs) {
+  const before = s.nextId;
+  const ev = [];
+  for (let i = 0; i < ticks(secs); i++) {
+    s.queue = [];
+    sim.update(s, DT, ev);
+  }
+  return { spawns: s.nextId - before, ev };
+}
+
+check('festivals start on a fixed cadence and cycle through their names', () => {
+  const s = sim.newGame();
+  const ev = [];
+  const starts = [];
+  for (let i = 0; i < ticks(FESTIVAL_EVERY_SECONDS * 2 + 60); i++) {
+    ev.length = 0;
+    sim.update(s, DT, ev);
+    for (const e of ev) if (e.type === 'festival' && e.active) starts.push([e.name, s.time]);
+  }
+  assert.equal(starts.length, 2);
+  assert.equal(starts[0][0], FESTIVALS[0].name);
+  assert.equal(starts[1][0], FESTIVALS[1].name);
+  assert.ok(Math.abs(starts[0][1] - FESTIVAL_EVERY_SECONDS) < 0.5, 'first festival on schedule');
+  assert.ok(Math.abs(starts[1][1] - 2 * FESTIVAL_EVERY_SECONDS) < 0.5, 'second festival on schedule');
+});
+
+check('a festival ends after its rush and reports it', () => {
+  const s = sim.newGame();
+  const ev = [];
+  let ended = false;
+  for (let i = 0; i < ticks(FESTIVAL_EVERY_SECONDS + FESTIVAL_SECONDS + 5); i++) {
+    ev.length = 0;
+    sim.update(s, DT, ev);
+    if (ev.some((e) => e.type === 'festival' && !e.active)) ended = true;
+  }
+  assert.ok(ended, 'an end event should fire');
+  assert.equal(s.festival.left, 0);
+});
+
+check('a festival raises customer arrivals', () => {
+  const normal = sim.newGame();
+  normal.festival.next = 1e9; // no festival in this window
+  const normalSpawns = spawnsOver(normal, 60).spawns;
+
+  const rush = sim.newGame();
+  rush.festival.left = 1e9; // festival in progress for the whole window
+  const rushSpawns = spawnsOver(rush, 60).spawns;
+
+  assert.ok(rushSpawns > normalSpawns * 1.4, `rush ${rushSpawns} should beat normal ${normalSpawns}`);
+});
+
+check('customers are drawn from every kind and carry their kind', () => {
+  const s = sim.newGame();
+  s.stage = 2; // roomy queue
+  const kinds = new Set();
+  const ev = [];
+  for (let i = 0; i < ticks(600); i++) {
+    s.queue = [];
+    ev.length = 0;
+    sim.update(s, DT, ev);
+    for (const e of ev) if (e.type === 'arrived') kinds.add(e.kind);
+  }
+  for (const k of Object.keys(CUSTOMER_KINDS)) assert.ok(kinds.has(k), `${k} should appear`);
+});
+
+check('a student is more impatient than a local', () => {
+  const s = sim.newGame();
+  s.stage = 2;
+  let sawStudent = false;
+  let sawLocal = false;
+  for (let i = 0; i < 2000; i++) {
+    s.queue = [];
+    sim.update(s, DT, []);
+    for (const c of s.queue) {
+      if (c.kind === 'student') {
+        sawStudent = true;
+        assert.ok(c.maxPatience < 40, 'students wait less than the standard 40s');
+      }
+      if (c.kind === 'local') {
+        sawLocal = true;
+        assert.equal(c.maxPatience, 40);
+      }
+    }
+    if (sawStudent && sawLocal) break;
+  }
+  assert.ok(sawStudent && sawLocal);
+});
+
+check('a tourist tips more than a local for the same plate', () => {
+  const pay = (kind) => {
+    const s = sim.newGame();
+    s.money = 0;
+    s.stock.steamed = 1;
+    s.queue = [{ id: 1, name: 'T', kind, item: 'steamed', qty: 1, patience: 40, maxPatience: 40, look: 0 }];
+    const ev = [];
+    assert.equal(sim.serve(s, 1, ev), true);
+    return ev.find((e) => e.type === 'served').pay;
+  };
+  const tourist = pay('tourist');
+  const local = pay('local');
+  assert.ok(tourist > local, `tourist ${tourist} should beat local ${local}`);
+  // Locals get the standard 10% patience tip; tourists add their own 30% on top.
+  assert.equal(local, Math.round(30 * 1.1));
+  assert.equal(tourist, Math.round(30 * (1 + 0.1 + CUSTOMER_KINDS.tourist.tip)));
+});
+
+check('every kind has a weight, patience and tip', () => {
+  for (const [k, d] of Object.entries(CUSTOMER_KINDS)) {
+    assert.ok(d.weight > 0, `${k} weight`);
+    assert.ok(d.patience > 0, `${k} patience`);
+    assert.ok(d.tip >= 0, `${k} tip`);
+  }
+});
+
+console.log(`\n${passed} feature checks passed`);
diff --git a/tests/progression.mjs b/tests/progression.mjs
new file mode 100644
index 0000000..93039e0
--- /dev/null
+++ b/tests/progression.mjs
@@ -0,0 +1,294 @@
+// Headless progression check: plays seeded games with a simple, human-like strategy
+// and reports game time to each milestone. Run with: node tests/progression.mjs
+// Options: --seeds N (default 24), --verbose (print every run).
+import * as sim from '../js/sim.js';
+import { ITEMS, ITEM_ORDER, UPGRADES, DECOR, STAFF, STAGES, CUSTOMER_KINDS } from '../js/data.js';
+
+const DT = 0.1; // same max step the game uses
+const ACTION_SECONDS = 1; // one tap or purchase per second, at most
+const CAP_SECONDS = 60 * 60; // a run that has not reached Busy Restaurant by now is a dead end
+const args = process.argv.slice(2);
+const SEEDS = Number(args[args.indexOf('--seeds') + 1]) || 24;
+const VERBOSE = args.includes('--verbose');
+
+// Targets from the design brief, in game seconds (medians across seeds).
+const TARGETS = {
+  firstUpgrade: { max: 60 },
+  firstHire: { max: 180 },
+  littleShop: { min: 480, max: 720 },
+  busyRestaurant: { min: 1500, max: 2400 },
+};
+
+// Everything the game can sell, priced with the sim's own cost functions. A player
+// who is still holding more cash than this at the cap has nothing left worth buying.
+function totalSinks() {
+  let total = 0;
+  for (const it of Object.values(ITEMS)) total += it.unlock;
+  for (const d of Object.values(DECOR)) total += d.cost;
+  for (const d of Object.values(STAFF)) total += d.hire * d.max;
+  for (const k of Object.keys(UPGRADES)) {
+    for (let lvl = 0; lvl < UPGRADES[k].max; lvl++) {
+      total += sim.upgradeCost({ upgrades: { [k]: lvl } }, k);
+    }
+  }
+  for (let b = 2; b < STAGES[STAGES.length - 1].maxBaskets; b++) total += sim.basketCost({ baskets: b });
+  for (const st of STAGES.slice(1)) total += st.cost;
+  return total;
+}
+
+// Seeded RNG so every run is repeatable. sim.js calls Math.random directly.
+function mulberry32(seed) {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = a;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+// The player's purchase order. Each goal blocks until it is bought, so the player
+// saves for it rather than spending on later things. Expansions come before the
+// items that need them, so the plan never waits on a locked stage.
+const up = (key, level) => ({
+  done: (s) => s.upgrades[key] >= level,
+  act: (s) => sim.buyUpgrade(s, key),
+});
+const hire = (role, n) => ({
+  done: (s) => s.staff[role] >= n,
+  act: (s) => sim.hire(s, role),
+});
+const basket = (n) => ({
+  done: (s) => s.baskets >= n,
+  act: (s) => sim.buyBasket(s),
+});
+const unlock = (key) => ({
+  done: (s) => s.unlocked[key],
+  act: (s) => sim.unlockItem(s, key),
+});
+const decor = (key) => ({
+  done: (s) => s.decor[key],
+  act: (s) => sim.buyDecor(s, key),
+});
+const expand = (stage) => ({
+  done: (s) => s.stage >= stage,
+  act: (s) => sim.expand(s, null),
+});
+
+const PLAN = [
+  up('speed', 1),
+  hire('cook', 1),
+  up('batch', 1),
+  decor('flags'),
+  unlock('jhol'),
+  hire('waiter', 1),
+  up('recipe', 1),
+  basket(3),
+  expand(1),
+  up('speed', 3),
+  hire('cook', 2),
+  basket(4),
+  up('batch', 2),
+  decor('garland'),
+  unlock('cmomo'),
+  hire('waiter', 2),
+  up('recipe', 3),
+  basket(5),
+  decor('lanterns'),
+  unlock('fried'),
+  expand(2),
+  up('speed', 5),
+  up('batch', 3),
+  up('recipe', 6),
+  basket(6),
+  basket(7),
+  basket(8),
+  hire('waiter', 3),
+];
+
+// The unlocked momo with the most unmet queued demand, or null if nothing is wanted.
+function bestItem(s) {
+  let best = null;
+  let bestD = 0;
+  for (const k of ITEM_ORDER) {
+    if (!s.unlocked[k]) continue;
+    const d = sim.demand(s, k);
+    if (d > bestD) {
+      bestD = d;
+      best = k;
+    }
+  }
+  return best;
+}
+
+// One player action, in priority order: serve a customer, collect a ready steamer,
+// load an empty one, then buy the next plan item if it is affordable.
+function doOneAction(s, ev, plan, planIdx) {
+  for (const c of s.queue) {
+    if ((s.stock[c.item] || 0) >= c.qty) return sim.serve(s, c.id, ev);
+  }
+  for (let i = 0; i < s.baskets; i++) {
+    if (s.slots[i].state === 'ready') return sim.tapBasket(s, i, ev);
+  }
+  for (let i = 0; i < s.baskets; i++) {
+    if (s.slots[i].state === 'idle') {
+      const item = bestItem(s);
+      if (item) return sim.loadBasket(s, i, item);
+    }
+  }
+  let idx = planIdx;
+  while (idx < plan.length && plan[idx].done(s)) idx++;
+  return idx < plan.length && plan[idx].act(s);
+}
+
+function playOnce(seed) {
+  const prev = Math.random;
+  Math.random = mulberry32(seed);
+  try {
+    const s = sim.newGame();
+    const ev = [];
+    const m = {};
+    const mark = (key) => { if (m[key] === undefined) m[key] = s.time; };
+    let planIdx = 0;
+    let lastServed = 0;
+    let longestDry = 0;
+    let dryStart = 0;
+    const money = [];
+    let nextSample = 0;
+
+    let actionAcc = ACTION_SECONDS;
+    const kinds = { arrived: {}, served: {} };
+    let festivals = 0;
+
+    while (s.time < CAP_SECONDS) {
+      ev.length = 0;
+      sim.update(s, DT, ev);
+
+      // The player makes one tap or purchase per ACTION_SECONDS, so the opening
+      // is paced by human hands rather than by instant reactions.
+      actionAcc = Math.min(actionAcc + DT, ACTION_SECONDS);
+      if (actionAcc >= ACTION_SECONDS && doOneAction(s, ev, PLAN, planIdx)) {
+        actionAcc = 0;
+        while (planIdx < PLAN.length && PLAN[planIdx].done(s)) planIdx++;
+      }
+
+      for (const e of ev) {
+        if (e.type === 'arrived') kinds.arrived[e.kind] = (kinds.arrived[e.kind] || 0) + 1;
+        if (e.type === 'served') kinds.served[e.kind] = (kinds.served[e.kind] || 0) + e.qty;
+        if (e.type === 'festival' && e.active) festivals++;
+      }
+
+      if (s.served > lastServed) {
+        longestDry = Math.max(longestDry, s.time - dryStart);
+        dryStart = s.time;
+        lastServed = s.served;
+      }
+
+      if (s.upgrades.speed + s.upgrades.batch + s.upgrades.recipe > 0) mark('firstUpgrade');
+      if (s.staff.cook + s.staff.waiter > 0) mark('firstHire');
+      if (s.stage >= 1) mark('littleShop');
+      if (s.stage >= 2) mark('busyRestaurant');
+      if (Object.values(s.unlocked).every(Boolean)) mark('fullMenu');
+      if (planIdx >= PLAN.length) mark('planDone');
+      if (s.time >= nextSample) {
+        money.push({ t: s.time, money: s.money, earned: s.totalEarned });
+        nextSample += 300;
+      }
+    }
+    longestDry = Math.max(longestDry, s.time - dryStart);
+    return { seed, m, s, money, longestDry, kinds, festivals };
+  } finally {
+    Math.random = prev;
+  }
+}
+
+const fmt = (sec) => (sec === undefined ? '  never' : `${(sec / 60).toFixed(1).padStart(5)} min`);
+const median = (xs) => {
+  const v = xs.filter((x) => x !== undefined).sort((a, b) => a - b);
+  if (!v.length) return undefined;
+  const mid = Math.floor(v.length / 2);
+  return v.length % 2 ? v[mid] : (v[mid - 1] + v[mid]) / 2;
+};
+
+const runs = [];
+for (let seed = 1; seed <= SEEDS; seed++) runs.push(playOnce(seed));
+
+const KEYS = ['firstUpgrade', 'firstHire', 'littleShop', 'busyRestaurant', 'fullMenu', 'planDone'];
+const LABELS = {
+  firstUpgrade: 'First upgrade',
+  firstHire: 'First hire',
+  littleShop: 'Little Shop',
+  busyRestaurant: 'Busy Restaurant',
+  fullMenu: 'Full menu',
+  planDone: 'Whole purchase plan',
+};
+
+console.log(`Progression over ${SEEDS} seeded runs (game time, cap ${CAP_SECONDS / 60} min)\n`);
+console.log('Milestone            median        min        max    reached');
+const medians = {};
+for (const k of KEYS) {
+  const xs = runs.map((r) => r.m[k]).filter((x) => x !== undefined);
+  medians[k] = median(xs);
+  const lo = xs.length ? Math.min(...xs) : undefined;
+  const hi = xs.length ? Math.max(...xs) : undefined;
+  console.log(
+    `${LABELS[k].padEnd(20)} ${fmt(medians[k])}  ${fmt(lo)}  ${fmt(hi)}   ${xs.length}/${SEEDS}`,
+  );
+}
+
+const dead = runs.filter((r) => r.m.busyRestaurant === undefined).length;
+const longestDry = Math.max(...runs.map((r) => r.longestDry));
+const endMoney = runs.map((r) => r.s.money);
+const endEarned = runs.map((r) => r.s.totalEarned);
+const sinks = totalSinks();
+const festivalsPerRun = runs.map((r) => r.festivals);
+const arrivals = {};
+const served = {};
+for (const r of runs) {
+  for (const [k, n] of Object.entries(r.kinds.arrived)) arrivals[k] = (arrivals[k] || 0) + n;
+  for (const [k, n] of Object.entries(r.kinds.served)) served[k] = (served[k] || 0) + n;
+}
+const totalArrivals = Object.values(arrivals).reduce((a, b) => a + b, 0);
+console.log(`\nDead-end runs (no Busy Restaurant by cap): ${dead}`);
+console.log(`Longest gap with no sales: ${longestDry.toFixed(0)}s`);
+console.log(`Money at cap (median / max): Rs ${Math.round(median(endMoney))} / Rs ${Math.max(...endMoney)}`);
+console.log(`Total price of everything buyable: Rs ${sinks}`);
+console.log(`Earned by cap (median): Rs ${Math.round(median(endEarned))}`);
+console.log(`Festivals per run: ${festivalsPerRun.join(', ')}`);
+console.log('Customer kinds (share of arrivals, share of momos served):');
+for (const k of Object.keys(CUSTOMER_KINDS)) {
+  const arr = ((arrivals[k] || 0) / totalArrivals * 100).toFixed(0);
+  const srv = ((served[k] || 0) / Object.values(served).reduce((a, b) => a + b, 0) * 100).toFixed(0);
+  console.log(`  ${CUSTOMER_KINDS[k].name.padEnd(8)} ${arr.padStart(3)}%   ${srv.padStart(3)}%`);
+}
+
+if (VERBOSE) {
+  for (const r of runs) {
+    console.log(`\nseed ${r.seed}: served ${r.s.served}, lost ${r.s.lost}, rep ${r.s.rep.toFixed(0)}, stage ${r.s.stage}`);
+    for (const p of r.money) console.log(`  t=${(p.t / 60).toFixed(0)}m money Rs ${Math.round(p.money)} earned Rs ${Math.round(p.earned)}`);
+  }
+}
+
+// Checks: printed above; a failing target exits non-zero so the test can gate changes.
+const failures = [];
+for (const [k, t] of Object.entries(TARGETS)) {
+  const v = medians[k];
+  if (v === undefined) failures.push(`${k}: never reached`);
+  else if (t.min !== undefined && v < t.min) failures.push(`${k}: ${(v / 60).toFixed(1)} min is under ${t.min / 60} min`);
+  else if (t.max !== undefined && v > t.max) failures.push(`${k}: ${(v / 60).toFixed(1)} min is over ${t.max / 60} min`);
+}
+if (dead) failures.push(`${dead} dead-end runs`);
+if (longestDry > 240) failures.push(`a ${longestDry.toFixed(0)}s gap with no sales`);
+// No runaway: nobody should sit on more cash at the cap than the whole game costs.
+if (Math.max(...endMoney) > sinks) failures.push(`money ${Math.max(...endMoney)} is above the Rs ${sinks} of purchases`);
+if (festivalsPerRun.some((n) => n < 6)) failures.push('a run had fewer than six festivals');
+
+console.log('');
+if (failures.length) {
+  console.log('FAIL');
+  for (const f of failures) console.log(`  - ${f}`);
+  process.exitCode = 1;
+} else {
+  console.log('PASS');
+}
diff --git a/tests/saves.mjs b/tests/saves.mjs
new file mode 100644
index 0000000..cb1858d
--- /dev/null
+++ b/tests/saves.mjs
@@ -0,0 +1,120 @@
+// Save compatibility: saves written before festivals and customer kinds existed must
+// still load, get sane defaults for the new state, and keep playing.
+// Run with: node tests/saves.mjs
+import assert from 'node:assert/strict';
+import * as sim from '../js/sim.js';
+
+// Minimal localStorage stand-in for Node.
+const store = new Map();
+globalThis.localStorage = {
+  getItem: (k) => (store.has(k) ? store.get(k) : null),
+  setItem: (k, v) => store.set(k, String(v)),
+  removeItem: (k) => store.delete(k),
+};
+
+// A save as the game wrote it before this change: no festival field.
+const OLD_SAVE = {
+  v: 1,
+  money: 1234,
+  totalEarned: 5000,
+  served: 80,
+  lost: 3,
+  rep: 52,
+  stage: 1,
+  baskets: 4,
+  slots: [
+    { state: 'cooking', item: 'steamed', left: 4, total: 8, count: 4 },
+    { state: 'idle', item: null, left: 0, total: 0, count: 0 },
+  ],
+  upgrades: { speed: 2, batch: 1, recipe: 0 },
+  unlocked: { steamed: true, jhol: true, cmomo: false, fried: false },
+  decor: { flags: true, garland: false, lanterns: false },
+  staff: { cook: 1, waiter: 0 },
+  stock: { steamed: 6, jhol: 0, cmomo: 0, fried: 0 },
+  cookChoice: 'steamed',
+  queue: [{ id: 9, name: 'Sita', item: 'steamed', qty: 1, patience: 20, maxPatience: 40 }],
+  nextId: 40,
+  spawnIn: 2,
+  payIn: 30,
+  cookAcc: 0,
+  waiterAcc: 0,
+  time: 900,
+  achievements: ['first', 'shop'],
+};
+
+function roundTrip(data) {
+  store.set(sim.SAVE_KEY, JSON.stringify(data));
+  return sim.loadGame();
+}
+
+let passed = 0;
+function check(name, fn) {
+  fn();
+  passed++;
+  console.log(`ok  ${name}`);
+}
+
+check('an old save loads and keeps its progress', () => {
+  const s = roundTrip(OLD_SAVE);
+  assert.ok(s, 'old save should load');
+  assert.equal(s.money, 1234);
+  assert.equal(s.stage, 1);
+  assert.equal(s.upgrades.speed, 2);
+  assert.equal(s.staff.cook, 1);
+  assert.deepEqual(s.achievements, ['first', 'shop']);
+  assert.deepEqual(s.queue, [], 'queue is rebuilt, not restored');
+});
+
+check('an old save gets default festival state', () => {
+  const s = roundTrip(OLD_SAVE);
+  assert.equal(s.festival.left, 0);
+  assert.equal(s.festival.count, 0);
+  assert.equal(s.festival.name, null);
+  assert.equal(s.festival.next, 480);
+});
+
+check('an old save keeps playing, including the first festival', () => {
+  const s = roundTrip(OLD_SAVE);
+  const ev = [];
+  for (let i = 0; i < 6000; i++) sim.update(s, 0.1, ev); // 600 s of play
+  assert.ok(ev.some((e) => e.type === 'festival' && e.active), 'a festival should start');
+  assert.ok(s.money >= 0 && Number.isFinite(s.money));
+});
+
+check('corrupt festival fields are repaired, not trusted', () => {
+  const s = roundTrip({ ...OLD_SAVE, festival: { next: 'soon', left: -5, count: 'two', name: 7 } });
+  assert.equal(s.festival.next, 480);
+  assert.equal(s.festival.left, 0);
+  assert.equal(s.festival.count, 0);
+  assert.equal(s.festival.name, null);
+});
+
+check('out-of-range festival timers are clamped to their schedule', () => {
+  const s = roundTrip({ ...OLD_SAVE, festival: { next: -1e9, left: 1e9, count: 3, name: 'Tihar' } });
+  assert.equal(s.festival.next, 0);
+  assert.equal(s.festival.left, 90);
+  assert.equal(s.festival.count, 3);
+  assert.equal(s.festival.name, 'Tihar');
+});
+
+check('a festival save round-trips through saveGame and loadGame', () => {
+  const g = sim.newGame();
+  const ev = [];
+  for (let i = 0; i < 5000; i++) sim.update(g, 0.1, ev); // 500 s: inside the first festival
+  assert.ok(g.festival.left > 0, 'should be mid-festival');
+  sim.saveGame(g);
+  const back = sim.loadGame();
+  assert.deepEqual(back.festival, g.festival);
+  assert.equal(back.money, g.money);
+});
+
+check('a save from a different version is still refused', () => {
+  assert.equal(roundTrip({ ...OLD_SAVE, v: 2 }), null);
+});
+
+check('loading garbage returns null rather than throwing', () => {
+  store.set(sim.SAVE_KEY, '{not json');
+  assert.equal(sim.loadGame(), null);
+});
+
+console.log(`\n${passed} save checks passed`);
